<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="
        http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

    <!-- bean definitions here -->

    <bean id="carSpecification" class="car.constructor.injection.Specification">
        <property name="make" value = "this car has been created since 1920 b.s " ></property>
        <property name="model" value = "toyata" ></property>
    </bean>

    <bean id="MyCar" class="car.constructor.injection.Car">
        <constructor-arg ref="carSpecification"/>
    </bean>
</beans>